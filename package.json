{
  "name": "mzsh",
  "version": "1.0.0",
  "private": false,
  "bin": {
    "mzsh": "./bin/run-standalone.ts"
  },
  "type": "commonjs",
  "module": "index.ts",
  "scripts": {
    "build": "bun run clean && tsc && bun build lib/index.js --outdir dist --target bun --minify",
    "build:dev": "bun run clean && tsc && bun build lib/index.js --outdir dist --target bun",
    "build:ts": "tsc",
    "clean": "rm -rf dist lib",
    "prebuild": "bun run clean",
    "inst": "./install.sh",
    "uninst": "./uninstall.sh",
    "start": "bun run bin/run.ts",
    "mzsh": "bun run bin/run-standalone.ts",
    "update": "printf '%s\\n' 'MZSH legacy update is retired. Run: bun run mzsh -- update --source /absolute/mzsh-checkout [--apply]' && exit 2",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "shell:check": "bash scripts/check-shell-quality.sh",
    "line:check": "bun scripts/check-typescript-line-limits.ts",
    "quality:check": "bun run lint && bun run format:check && bun run shell:check && bun run line:check"
  },
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-help": "^6.3.0",
    "chalk": "^5.6.2",
    "fs-extra": "^11.4.0",
    "inquirer": "^12.11.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "oclif": {
    "bin": "mzsh",
    "commands": "./lib",
    "dirname": "mzsh",
    "plugins": [
      "@oclif/plugin-help"
    ]
  }
}
